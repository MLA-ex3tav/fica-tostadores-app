{
  "name": "fica-tostadores-app",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para administración de Fica Tostadores",
  "main": "electron/main.js",
  "author": "Fica Tostadores",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/MLA-ex3tav/fica-tostadores-app.git"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "firestore:inspect": "node scripts/firestore-inspect.mjs",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev --enable-logging",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "publish:win": "npm run build:renderer && electron-builder --win --publish always",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@pdfslick/core": "^4.0.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.3.9",
    "firebase": "^11.1.0",
    "lucide": "^1.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.fica.tostadores",
    "productName": "Fica Tostadores",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MLA-ex3tav",
        "repo": "fica-tostadores-app"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    }
  }
}
